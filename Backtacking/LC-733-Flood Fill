class Solution {
public:

    void fun(vector<vector<int>>&image,int call_i,int call_j,int color,int start){
            if(call_i<0 || call_j<0 || call_i>=image.size() || call_j>=image[0].size())return;//if we cross out of grid
            if(image[call_i][call_j]==color)return;//already colored
           
            if(image[call_i][call_j]!=start)return;//not same as starting point
            image[call_i][call_j]=color;//valid color it

            fun(image,call_i+1,call_j,color,start);
            fun(image,call_i-1,call_j,color,start);
            fun(image,call_i,call_j+1,color,start);
            fun(image,call_i,call_j-1,color,start);


    }

    vector<vector<int>> floodFill(vector<vector<int>>& image, int sr, int sc, int color) {
        int start=image[sr][sc];//we have to start with the srsc 
        fun(image,sr,sc,color,start);
        return image;
    }
};