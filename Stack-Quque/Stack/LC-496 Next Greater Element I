class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        stack<int>st;
        unordered_map<int,int>mp;
        vector<int>ans;
        for(int i =nums2.size()-1;i>=0;i--){
            int current=nums2[i];
            while(!st.empty() && st.top()<=current){
                st.pop();
            }

            mp[current] = st.empty() ? -1 : st.top();

            st.push(current);





        }
            for(int x: nums1){
                ans.push_back(mp[x]);
            }

            return ans;

    }
};