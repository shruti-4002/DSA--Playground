class Solution {
public:
    int minCostClimbingStairs(vector<int>& cost) {
        int n = cost.size();

        vector<int> dp(n + 2, 0);

        // Fill from last step to first
        for(int i = n - 1; i >= 0; i--) {
            dp[i] = cost[i] + min(dp[i + 1], dp[i + 2]);
        }

        // Answer: min(start at 0 or 1)
        return min(dp[0], dp[1]);
    }
};
