class Solution {
public:

    int tab(vector<int>arr){
        vector<int>dp(arr.size()+2,0);
        for(int i=arr.size()-1;i>=0;i--){
            dp[i]=max(dp[i+1],dp[i+2]+arr[i]);
        }
        return dp[0];
    }


    int rob(vector<int>& nums) {
        if(nums.size()==1)return nums[0];
        
        vector<int>part1;
        vector<int>part2;
        for(int i=0 ;i<nums.size();i++){
            if(i!=0){
            part1.push_back(nums[i]);       
            }
            if(i!=nums.size()-1){
                 part2.push_back(nums[i]);    

        }
        }

        int way1=tab(part1);
        int way2=tab(part2);
        return max(way1,way2);



    }
};