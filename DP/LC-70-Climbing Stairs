class Solution {
public:


    int ans(int n,vector<int>&dp){
    
    if(n==0)return 1;//success
     if(n<0)return 0;//fail
     if(dp[n]!=0)return dp[n];
     int findtwoways=ans(n-2,dp);
     int onestep=ans(n-1,dp);
     return dp[n]= findtwoways+onestep;


    }

    int climbStairs(int n) {
        vector<int>dp(n+1,0);
     int ansi=ans(n,dp);
        return ansi;
    
    }



};


//tabulation:
class Solution {
public:
    int climbStairs(int n) {
        vector<int>dp(n+1,0);
        dp[0]=1;
        dp[1]=1;
        for(int i=2;i<=n;i++){
            dp[i]=dp[i-2]+dp[i-1];
        }
        return dp[n];
    }
};

//space optimised
class Solution {
public:
    int climbStairs(int n) {

        int prev1 = 1;
        int prev2 = 1;

        for(int i = 2; i <= n; i++) {
            int curr = prev1 + prev2;
            prev2 = prev1;
            prev1 = curr;
        }

        return prev1;
    }
};
