// Problem: LeetCode 918 - Maximum Sum Circular Subarray
// Platform: LeetCode
// Language: C++
// Approach: Kadane for max subarray + Kadane on inverted array for min subarray
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:

    int kadanemax(vector<int> nums){
        int MaxSoFar = 0;
        int FinalMax = INT_MIN;

        for(int i=0; i<nums.size(); i++){
            MaxSoFar += nums[i];
            FinalMax = max(FinalMax, MaxSoFar);

            if(MaxSoFar < 0){
                MaxSoFar = 0;
            }
        }
        return FinalMax;
    }

    int low(vector<int> nums){
        int MaxSoFar = 0;
        int FinalMax = INT_MIN;

        for(int i=0; i<nums.size(); i++){
            int Sign = -nums[i];
            MaxSoFar += Sign;
            FinalMax = max(FinalMax, MaxSoFar);

            if(MaxSoFar < 0){
                MaxSoFar = 0;
            }
        }
        return FinalMax;
    }

    int maxSubarraySumCircular(vector<int>& nums) {
        int Max = kadanemax(nums);
        int Low = low(nums) * -1;
        int TotalSum = 0;

        for(int i=0; i<nums.size(); i++){
            TotalSum += nums[i];
        }

        // Edge case: all negative
        if(Max < 0) return Max;

        return max(TotalSum - Low, Max);
    }
};
