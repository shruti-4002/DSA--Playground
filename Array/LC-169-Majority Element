// Problem: LeetCode 169 - Majority Element
// Platform: LeetCode
// Language: C++
// Approach: Boyer-Moore Voting 
// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
public:
    int majorityElement(vector<int>& nums) {

        int candidate = nums[0];
        int count = 1;

        for (int i = 1; i < nums.size(); i++) {

            if (nums[i] == candidate) {
                count++;
            } else {
                count--;
            }

            // If count becomes 0, update candidate to current element
            if (count == 0) {
                candidate = nums[i];
                count = 1;
            }
        }

        return candidate;
    }
};
