class Solution {

public:
    int shortestPathBinaryMatrix(vector<vector<int>>& grid) {
        queue<pair<int,int>>q;
        int n=grid.size();
        int m=grid[0].size();
        vector<vector<bool>>visited(n,vector<bool>(m,false));
       if (grid[0][0] == 1 || grid[n-1][n-1] == 1) return -1;
        if(n-1==0 && m-1==0)return 1;
        q.push({0,0});
        visited[0][0]=true;
        int path=1;
       

        
    vector<pair<int,int>>dir={
        {1,0},{1,1},{1,-1},{-1,1},{-1,0},{-1,-1},{0,1},{0,-1}
    };


        while(!q.empty()){
            int size=q.size();
            
            for(int i=0;i<size;i++){
                auto it=q.front();
                q.pop();
             int   curr_i=it.first;
             int   curr_j=it.second;

                for(auto& d:dir){
                int new_i=curr_i+d.first;
                int new_j=curr_j+d.second;
                if(new_i<0 || new_j<0 || new_i>=n || new_j>=m || grid[new_i][new_j]==1 ||visited[new_i][new_j]==true)continue;
                if(new_i==n-1 && new_j==m-1){
                   
                    return ++path;
                    
                   
                }
                q.push({new_i,new_j});
                visited[new_i][new_j]=true;
               
                
                }



            }
           
            path++;

        }
       
       
        return -1;

    }
};