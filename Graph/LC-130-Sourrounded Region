class Solution {
public:

    void fun(vector<vector<char>>&board ,int i,int j){
        if(i<0 || j<0 || i>=board.size() || j>=board[0].size())return;
         
          if(board[i][j] != 'O') return;
          
            board[i][j]='#';
          
        fun(board,i+1,j);
        fun(board,i-1,j);
        fun(board,i,j-1);
        fun(board,i,j+1);
    }

    void solve(vector<vector<char>>& board) {
     int   n = board.size();
      int   m = board[0].size();

    for(int j=0;j<m;j++){
        if(board[0][j]=='O'){
            fun(board,0,j);
        }

        if(board[n-1][j]=='O'){
            fun(board,n-1,j);
        }

    }
      
    for(int i=0;i<n;i++){
        if(board[i][0]=='O'){
            fun(board,i,0);
        }
        if(board[i][m-1]=='O'){
            fun(board,i,m-1);
        }
    }







        for(int i=0;i<board.size();i++){
            for(int j=0;j<board[0].size();j++){
                if(board[i][j]=='O'){
                    board[i][j]='X';
                }
                if(board[i][j]=='#'){
                    board[i][j]='O';
                }
            }
        }
        
    }
};