//without extra space

class Solution {
public:


void explorefullisland(vector<vector<char>>& grid, int i, int j){
        if(i<0 || j<0 || i>=grid.size() || j>=grid[0].size())return;
        
        if(grid[i][j]=='0')return ;
        grid[i][j]='0';
       
        explorefullisland(grid,i-1,j);
        explorefullisland(grid,i+1,j);
        explorefullisland(grid,i,j+1);
        explorefullisland(grid,i,j-1);
    }


    int numIslands(vector<vector<char>>& grid) {
     int rows = grid.size();
     int cols = grid[0].size();  

int island=0;

        for(int i=0;i<rows;i++){
            for(int j=0;j<cols;j++){
                if(grid[i][j]=='1'){
                    
                        island++;
                    explorefullisland(grid,i,j);
                    
                }
            }
        }
            return island;
    }
};