class Solution {
public:

    int orangesRotting(vector<vector<int>>& grid) {
        int n=grid.size();
        int m=grid[0].size();
        int a[4]={-1,1,0,0};
        int b[4]={0,0,-1,1};
        queue<pair<int,int>>q;
        int total=0;         
        int fresh=0;
        for(int i=0;i<n;i++){
            for(int j=0;j<m;j++){
                if(grid[i][j]==2)q.push({i,j});
                if(grid[i][j]==1)fresh++;
            }
        }

        int time=0;
        while(!q.empty()){
            int q_rot=q.size();
           
            bool rotthua=false;
        
        for(int k=0;k<q_rot;k++){

            auto it=q.front();
                q.pop();


            int curr_i=it.first;
            int curr_j=it.second;

        for(int d=0;d<4;d++){
            int new_i=curr_i+a[d] ;
            int new_j=curr_j+b[d];

            if(new_i <0 || new_j <0 || new_i >=n || new_j >=m || grid[new_i][new_j]!=1)continue;
            grid[new_i][new_j]=2;
            fresh--;
            q.push({new_i,new_j});
            rotthua=true;

        }
           
        }

       
            if(rotthua)time++;


        }


        return (fresh==0)?time:-1;


    }
};